{
  "name": "@vanya2h/form-factory",
  "version": "0.1.0",
  "description": "Headless schema-driven form factory built on react-hook-form + zod.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc -b --noEmit",
    "clean": "rimraf ./dist",
    "dev": "tsup --watch --silent",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "p-cancelable": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@vanya2h/eslint-config": "workspace:*",
    "@vanya2h/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "rxjs": "^7.0.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
